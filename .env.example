# ============================================================
# Atlas Release Platform — Environment Variables
# ============================================================
# Copy this file to Server/.env and Client/.env
# Fill in the values below. NEVER commit real credentials.
# ============================================================

# ── Server Configuration ─────────────────────────────────────

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>

# Express server port
PORT=5000

# CORS — allowed client origin
CLIENT_ORIGIN=http://localhost:5173

# ── Authentication ────────────────────────────────────────────

# JWT signing secret — CHANGE THIS before deploying to production
JWT_SECRET=your-secure-random-secret-here

# JWT token expiry (e.g., 7d, 24h, 1h)
JWT_EXPIRY=7d

# Bcrypt hashing rounds (10–12 recommended)
BCRYPT_ROUNDS=10

# ── AI / NVIDIA NIM ──────────────────────────────────────────

# NVIDIA API key for LLM-based brief generation (optional — fallback engine works without it)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NVIDIA NIM base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# NVIDIA model identifier
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# Legacy alias (some code references this)
CHAT_API_KEY_NVIDIA=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Client Configuration ─────────────────────────────────────

# API base URL (used by Vite — must be prefixed with VITE_)
VITE_API_BASE_URL=http://localhost:5000/api
